# API environment configuration.
# Copy to `.env` (git-ignored) and adjust locally. Never commit real secrets.

# Runtime mode: development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=4000

# Log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Version/build identifier surfaced by the health endpoints.
APP_VERSION=0.0.0
