{
  "name": "@resume-roast/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Express + TypeScript API for the AI Resume Roast Generator.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@resume-roast/shared": "workspace:*",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@resume-roast/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "25.9.3",
    "tsup": "8.5.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
