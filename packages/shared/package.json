{
  "name": "@resume-roast/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared types and utilities for the AI Resume Roast Generator.",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@resume-roast/config": "workspace:*",
    "@vitest/coverage-v8": "4.1.8",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
